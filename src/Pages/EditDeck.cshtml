@page "{id:int}"
@model mtg_game_tracker.Pages.EditDeckModel

<div class="mb-4">
    <h1 class="h3">Edit Deck</h1>
    <p class="text-muted mb-0">@Model.Deck!.Commander@(string.IsNullOrEmpty(Model.Deck.SecondCommander) ? "" : $" / {Model.Deck.SecondCommander}")</p>
</div>

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-12">
        <label asp-for="Name" class="form-label">Name (optional)</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="OwnerId" class="form-label">Owner</label>
        <select asp-for="OwnerId" class="form-select">
            <option value="">Select an owner</option>
            @foreach (var person in Model.People)
            {
                <option value="@person.Id">@person.Name</option>
            }
        </select>
        <span asp-validation-for="OwnerId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="DeckListUrl" class="form-label">Deck List (optional)</label>
        <input asp-for="DeckListUrl" type="url" class="form-control" />
        <span asp-validation-for="DeckListUrl" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="/Decks" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
