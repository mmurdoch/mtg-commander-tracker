@page
@model DecksModel

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3">Decks</h1>
        <p class="text-muted">Manage decks and their color identity.</p>
    </div>
    <a href="/AddDeck" class="btn btn-primary">Add deck</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Commander</th>
            <th>Owner</th>
            <th>Color Identity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var deck in Model.Decks)
        {
            <tr>
                <td>@deck.Name</td>
                <td>@(string.IsNullOrEmpty(deck.SecondCommander) ? deck.Commander : $"{deck.Commander} / {deck.SecondCommander}")</td>
                <td>@deck.Owner?.Name</td>
                <td>@(deck.ColorData is null ? "-" : $"{deck.ColorData.Name} ({deck.ColorData.Abbreviation})")</td>
            </tr>
        }
    </tbody>
</table>
