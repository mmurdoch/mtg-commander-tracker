@page
@using System.Globalization
@using mtg_game_tracker.Services
@model PersonModel
@{
    static string Pct(double value) => value.ToString("0", CultureInfo.InvariantCulture);

    BarRow WinRow(string label, ChartEntry entry, int players) => new(
        label,
        entry.Games == 0 ? 0 : (double)entry.Wins / entry.Games * 100,
        entry.Games == 0 ? "-" : $"{Pct((double)entry.Wins / entry.Games * 100)}% ({entry.Wins}/{entry.Games})",
        100.0 / players);

    var deckTotal = Model.DeckShares.Sum(d => d.Games);
    var winRows = WinCharts.PlayerCounts.Select((size, i) => WinRow(Model.WinsByPlayerCount[i].Label, Model.WinsByPlayerCount[i], size)).ToList();
    var deckRows = Model.DeckShares.Select(d => new BarRow(d.Label, d.Percent, $"{Pct(d.Percent)}% ({d.Games}/{deckTotal})", Url: d.DeckId is int deckId ? Url.Page("/Deck", new { id = deckId }) : null)).ToList();

    string[] palette = { "#4e73df", "#e74a3b", "#1cc88a", "#f6c23e", "#36b9cc", "#8e44ad", "#fd7e14", "#e83e8c", "#20c997", "#6c757d" };
    const double chartWidth = 720, chartHeight = 300, left = 40, right = 16, top = 12, bottom = 36;
    var plotWidth = chartWidth - left - right;
    var plotHeight = chartHeight - top - bottom;
    var monthCount = Model.PlayMonths.Count;
    var percentUsage = Model.SelectedUsage == PersonModel.UsagePercent;
    string? usageRoute = percentUsage ? null : PersonModel.UsageCount;
    var maxPlays = Model.DeckPlays.Count == 0 ? 1 : Math.Max(1, Model.DeckPlays.Max(d => d.Counts.Max()));
    double Value(DeckMonthlyPlays deck, int i) => percentUsage ? (Model.MonthTotals[i] == 0 ? 0 : (double)deck.Counts[i] / Model.MonthTotals[i] * 100) : deck.Counts[i];
    var maxPercent = Model.DeckPlays.Count == 0 ? 1 : Math.Max(1, Model.DeckPlays.Max(d => Enumerable.Range(0, d.Counts.Count).Max(i => Value(d, i))));
    // Percent steps are multiples of 5 so the axis has at most five intervals.
    var tickStep = percentUsage ? (int)Math.Ceiling(maxPercent / 25) * 5 : (int)Math.Ceiling(maxPlays / 5.0);
    var yMax = (int)Math.Ceiling((percentUsage ? maxPercent : maxPlays) / (double)tickStep) * tickStep;
    string Tip(DeckMonthlyPlays deck, int i) => percentUsage ? $"{Pct(Value(deck, i))}% ({deck.Counts[i]}/{Model.MonthTotals[i]})" : deck.Counts[i].ToString(CultureInfo.InvariantCulture);
    var labelStep = Math.Max(1, (int)Math.Ceiling(monthCount / (plotWidth / 64)));
    double X(int i) => monthCount == 1 ? left + plotWidth / 2 : left + plotWidth * i / (monthCount - 1);
    double Y(double count) => top + plotHeight * (1 - (double)count / yMax);
    static string Num(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3">@Model.Person!.Name</h1>
    </div>
    <a asp-page="/People" class="btn btn-outline-primary">All people</a>
</div>

<div class="timeframe-select mb-4" role="group" aria-label="Timeframe">
    @foreach (var timeframe in WinCharts.Timeframes)
    {
        <a class="timeframe-option" asp-page="/Person" asp-route-id="@Model.Person.Id" asp-route-timeframe="@(timeframe.Key == WinCharts.AllTime ? null : timeframe.Key)" asp-route-usage="@usageRoute" aria-pressed="@(timeframe.Key == Model.SelectedTimeframe ? "true" : "false")">@timeframe.Label</a>
    }
</div>

<div class="row g-4 mb-5">
    <div class="col-12 col-lg-6" data-chart="win-percent">
        <h2 class="h5">Win % by player count</h2>
        @if (Model.WinsByPlayerCount.All(e => e.Games == 0))
        {
            <p class="text-muted small mb-0">No games yet.</p>
        }
        else
        {
            <partial name="_BarChart" model="winRows" />
        }
    </div>
    <div class="col-12 col-lg-6" data-chart="deck-share">
        <h2 class="h5">Decks played</h2>
        @if (deckRows.Count == 0)
        {
            <p class="text-muted small mb-0">No decks recorded.</p>
        }
        else
        {
            <partial name="_BarChart" model="deckRows" />
        }
    </div>
</div>

<h2 class="h5">Win % by seat position</h2>
<div class="row g-4">
    @foreach (var size in WinCharts.PlayerCounts.OrderDescending())
    {
        var overall = Model.OverallSeats[size];
        var seatRows = Model.Seats[size]
            .Select((e, i) => new BarRow(
                e.Label,
                e.Games == 0 ? 0 : (double)e.Wins / e.Games * 100,
                e.Games == 0 ? "-" : $"{Pct((double)e.Wins / e.Games * 100)}% ({e.Wins}/{e.Games})",
                100.0 / size,
                i < overall.Count && overall[i].Games > 0 ? (double)overall[i].Wins / overall[i].Games * 100 : null,
                i < overall.Count && overall[i].Games > 0 ? $"{Model.Person!.Name}: {(e.Games == 0 ? "-" : $"{Pct((double)e.Wins / e.Games * 100)}% ({e.Wins}/{e.Games})")}\nOverall: {Pct((double)overall[i].Wins / overall[i].Games * 100)}% ({overall[i].Wins}/{overall[i].Games})" : null))
            .ToList();
        <div class="col-12 col-lg-4" data-chart="seats" data-players="@size">
            <h3 class="h6">@size-player win %</h3>
            @if (Model.Seats[size].All(e => e.Games == 0))
            {
                <p class="text-muted small mb-0">No games yet.</p>
            }
            else
            {
                <partial name="_BarChart" model="seatRows" />
            }
        </div>
    }
</div>

<div class="mt-5" data-chart="deck-plays">
    <h2 class="h5">Deck plays by month</h2>
    <div class="timeframe-select mb-3" role="group" aria-label="Deck plays unit">
        <a class="timeframe-option" asp-page="/Person" asp-route-id="@Model.Person.Id" asp-route-timeframe="@(Model.SelectedTimeframe == WinCharts.AllTime ? null : Model.SelectedTimeframe)" aria-pressed="@(percentUsage ? "true" : "false")">% of games</a>
        <a class="timeframe-option" asp-page="/Person" asp-route-id="@Model.Person.Id" asp-route-timeframe="@(Model.SelectedTimeframe == WinCharts.AllTime ? null : Model.SelectedTimeframe)" asp-route-usage="@PersonModel.UsageCount" aria-pressed="@(percentUsage ? "false" : "true")">Game count</a>
    </div>
    @if (Model.DeckPlays.Count == 0)
    {
        <p class="text-muted small mb-0">No deck plays yet.</p>
    }
    else
    {
        <svg class="line-chart" viewBox="0 0 @Num(chartWidth) @Num(chartHeight)" role="img" aria-label="@(percentUsage ? "Share of plays per month" : "Plays per month") for each of @Model.Person!.Name's decks">
            @for (var tick = 0; tick <= yMax; tick += tickStep)
            {
                <line class="line-chart-grid" x1="@Num(left)" x2="@Num(chartWidth - right)" y1="@Num(Y(tick))" y2="@Num(Y(tick))" />
                @* Razor treats a literal <text> element as a transition, so the SVG text nodes are emitted raw (numbers and dates only). *@
                @Html.Raw($"<text class=\"line-chart-label\" x=\"{Num(left - 6)}\" y=\"{Num(Y(tick) + 4)}\" text-anchor=\"end\">{tick}{(percentUsage ? "%" : "")}</text>")
            }
            @for (var i = 0; i < monthCount; i += labelStep)
            {
                @Html.Raw($"<text class=\"line-chart-label\" x=\"{Num(X(i))}\" y=\"{Num(chartHeight - bottom + 18)}\" text-anchor=\"middle\">{Model.PlayMonths[i].ToString("MMM yyyy", CultureInfo.InvariantCulture)}</text>")
            }
            @for (var d = 0; d < Model.DeckPlays.Count; d++)
            {
                var deck = Model.DeckPlays[d];
                var color = palette[d % palette.Length];
                var points = deck.Counts.Select((c, i) => $"{Num(X(i))},{Num(Y(Value(deck, i)))}").ToList();
                <g class="line-chart-series" data-deck="@deck.DeckId" stroke="@color" fill="@color">
                    <polyline fill="none" stroke-width="2" points="@string.Join(" ", points)" />
                    <path class="line-chart-hit" d="@("M" + string.Join(" L", points))" />
                    @for (var i = 0; i < monthCount; i++)
                    {
                        <circle cx="@Num(X(i))" cy="@Num(Y(Value(deck, i)))" r="3.5"><title>@deck.Label - @Model.PlayMonths[i].ToString("MMM yyyy", CultureInfo.InvariantCulture): @Tip(deck, i)</title></circle>
                    }
                </g>
            }
        </svg>
        <ul class="line-chart-legend list-unstyled d-flex flex-wrap gap-3 small mt-2 mb-0">
            @for (var d = 0; d < Model.DeckPlays.Count; d++)
            {
                var deck = Model.DeckPlays[d];
                <li data-deck="@deck.DeckId"><span class="line-chart-swatch" style="background: @palette[d % palette.Length]"></span><a asp-page="/Deck" asp-route-id="@deck.DeckId">@deck.Label</a></li>
            }
        </ul>
    }
</div>

@section Scripts {
    <script src="~/js/deck-plays-chart.js" asp-append-version="true"></script>
}
