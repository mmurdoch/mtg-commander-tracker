@page
@model IndexModel

<div class="mb-4">
    <h1 class="h3">Recent Games</h1>
    <p class="text-muted">Quick review of the last saved games.</p>
</div>

@if (Model.RecentGames.Any())
{
    <div class="list-group">
        @foreach (var game in Model.RecentGames)
        {
            <a class="list-group-item list-group-item-action mb-2" href="#">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">@game.Date.ToString("yyyy-MM-dd")</h5>
                    <small>@game.Participants.Count() players</small>
                </div>
                <p class="mb-1">Winner: @game.WinnerName</p>
                <small class="text-muted">@game.Notes</small>
            </a>
        }
    </div>
}
else
{
    <div class="alert alert-secondary">No games saved yet. Add one from the button above.</div>
}
