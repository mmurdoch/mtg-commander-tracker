@page
@model mtg_game_tracker.Pages.AddDeckModel
@{
    var selectedColor = Model.Colors.FirstOrDefault(c => c.Id == Model.ColorDataId);
}

<div class="mb-4">
    <h1 class="h3">Add Deck</h1>
    <p class="text-muted">Add a new deck and color identity.</p>
</div>

<form method="post" class="row g-3">
    <div class="col-12 col-md-6">
        <label class="form-label">Name (optional)</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Commander</label>
        <input asp-for="Commander" class="form-control" required />
        <span asp-validation-for="Commander" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">Owner</label>
        <select asp-for="OwnerId" class="form-select" required>
            <option value="" disabled selected>-- Select an owner --</option>
            @foreach (var person in Model.People)
            {
                <option value="@person.Id">@person.Name</option>
            }
        </select>
        <span asp-validation-for="OwnerId" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label" for="ColorFilter">Color Identity</label>
        <div id="ColorCombo" class="position-relative">
            <div class="input-group">
                <input type="text" id="ColorFilter" class="form-control" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="ColorList" autocomplete="off" placeholder="Select or search (e.g. Golgari, BG, GB)" value="@(selectedColor is null ? "" : $"{selectedColor.Name} ({selectedColor.Abbreviation})")" />
                <button type="button" id="ColorToggle" class="btn btn-outline-secondary" tabindex="-1" aria-label="Show color identities">&#9662;</button>
            </div>
            <input type="hidden" asp-for="ColorDataId" />
            <ul id="ColorList" class="list-group position-absolute w-100 shadow" role="listbox" style="max-height: 16rem; overflow-y: auto; z-index: 1000;" hidden>
                @foreach (var color in Model.Colors)
                {
                    <li class="list-group-item list-group-item-action" role="option" aria-selected="false" data-value="@color.Id" data-name="@color.Name" data-abbreviation="@color.Abbreviation">@color.Name (@color.Abbreviation)</li>
                }
            </ul>
        </div>
        <span asp-validation-for="ColorDataId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Add</button>
        <a href="/Decks" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/color-filter.js"></script>
}
