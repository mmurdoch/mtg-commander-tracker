@page
@using mtg_game_tracker.Services
@model DeckMatchupsModel

<div class="mb-4">
    <h1 class="h3">@Model.Selected!.Label</h1>
    <p class="text-muted mb-0">Best and worst matchups</p>
</div>

<div class="d-flex flex-wrap align-items-end gap-4 mb-4">
    <div style="width: 24rem; max-width: 100%">
        <label class="form-label small mb-1" for="minGames">Minimum games: <output class="min-games-value">5</output></label>
        <input type="range" class="form-range min-games-slider" id="minGames" min="1" max="40" step="1" value="5" />
    </div>
    <div>
        <div class="form-label small mb-1" id="playerFilterLabel">Player count</div>
        <div class="timeframe-select" id="player-filter" role="group" aria-labelledby="playerFilterLabel">
            <button type="button" class="timeframe-option" data-players="all" aria-pressed="true">All</button>
            @foreach (var size in WinCharts.PlayerCounts)
            {
                <button type="button" class="timeframe-option" data-players="@size" aria-pressed="false">@size</button>
            }
        </div>
    </div>
</div>

<div id="matchup-chart" data-deck-url="@Url.Page("/DeckMatchups")"></div>

<script type="application/json" id="deck-matchups-data">@Json.Serialize(new { selected = Model.Selected, matchups = Model.Matchups })</script>

@section Scripts {
    <script src="~/js/deck-matchups.js"></script>
}
